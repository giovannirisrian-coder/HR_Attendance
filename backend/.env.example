PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxxx
DB_NAME=beraucoal_attendance
JWT_SECRET=beraucoal_super_secret_jwt_key_2026
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Fingerspot — SQL Server (data_access)
FINGERSPOT_DB_HOST=localhost
FINGERSPOT_DB_PORT=1433
FINGERSPOT_DB_USER=sa
FINGERSPOT_DB_PASSWORD=xxxx
FINGERSPOT_DB_NAME=fingerspot
FINGERSPOT_DB_ENCRYPT=false
FINGERSPOT_DB_TRUST_CERT=true
# Opsional: nama tabel
# FINGERSPOT_DATA_ACCESS_TABLE=data_access

# FTM — MySQL (data_access + employee)
FTM_DB_HOST=localhost
FTM_DB_PORT=3306
FTM_DB_USER=root
FTM_DB_PASSWORD=xxxx
FTM_DB_NAME=ftm
# Opsional: nama tabel / kolom join
# FTM_DATA_ACCESS_TABLE=data_access
# FTM_EMPLOYEE_TABLE=employee
# FTM_EMP_JOIN_COLUMN=pin
# FTM_EMP_NIK_COLUMN=nik

# Sync cron (CLI): npm run sync:fingerspot / npm run sync:ftm
# ATT_SYNC_FINGERSPOT_LOOKBACK_DAYS=1
# ATT_SYNC_FTM_LOOKBACK_DAYS=1

PLACEHOLDER_PASSWORD=password
PLACEHOLDER_VENDOR_ID=1
PLACEHOLDER_SUPERVISOR_ID=3

# Google Cloud Storage — leave & vendor attachments (required in production)
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name
# Path to service account JSON (or set GOOGLE_APPLICATION_CREDENTIALS)
GCS_KEY_FILE=./path/to/service-account.json
# Signed download URL lifetime in minutes (default 15, max 60)
GCS_SIGNED_URL_EXPIRES_MINUTES=15

# Development only: when GCS is not set, store under backend/uploads/
#   leave-attachments/  — leave request files
#   vendor-attachment/  — vendor monthly report files
# Ignored when NODE_ENV=production (production always requires GCS)
# LEAVE_ATTACHMENT_LOCAL_FALLBACK=false
